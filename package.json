{
  "name": "llama-ai-studio",
  "productName": "Llama AI Studio",
  "version": "0.3.7",
  "description": "Local-first desktop studio for discovering, running, and supervising GGUF models with llama.cpp",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:win": "npm run build && electron-builder --win nsis",
    "icon": "electron scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.llamaaistudio.app",
    "productName": "Llama AI Studio",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Llama AI Studio"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-store": "^10.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
